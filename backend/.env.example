# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Application database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace-with-application-user
MYSQL_PASSWORD=replace-with-application-password
MYSQL_DATABASE=logotype
MYSQL_CONNECTION_LIMIT=10

# Dedicated test database: this database name must end in _test.
MYSQL_TEST_HOST=127.0.0.1
MYSQL_TEST_PORT=3306
MYSQL_TEST_USER=replace-with-test-user
MYSQL_TEST_PASSWORD=replace-with-test-password
MYSQL_TEST_DATABASE=logotype_test

# Required before tests are allowed to perform destructive cleanup.
TEST_DB_RESET_ALLOWED=false
